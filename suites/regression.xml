<?xml version="1.0" encoding="UTF-8"?>

<!-- Full regression suite: every functional test, UI + API. -->
<suite name="ShopFlow regression" verbose="1">

    <listeners>
        <listener class-name="com.shopflow.listeners.TestListener"/>
        <listener class-name="com.shopflow.listeners.RetryListener"/>
    </listeners>

    <test name="Regression">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <packages>
            <package name="com.shopflow.tests"/>
        </packages>
    </test>
</suite>
